[Unit]
Description=rtunnel agent connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rtunnel-agent run --state-dir /var/lib/rtunnel-agent
StateDirectory=rtunnel-agent
RuntimeDirectory=rtunnel-agent
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
